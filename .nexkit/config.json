{
  "version": 1,
  "agents": {
    "claude": {
      "runtime": "claude-code",
      "provider": "anthropic",
      "oauth_token_secret": "CLAUDE_CODE_OAUTH_TOKEN",
      "fallback": [
        "claude-fallback"
      ]
    },
    "claude-fallback": {
      "runtime": "claude-code",
      "provider": "anthropic",
      "oauth_token_secret": "CLAUDE_FALLBACK_OAUTH_TOKEN"
    }
  },
  "model": "claude-opus-5-5",
  "effort": "high",
  "setup": [
    "scripts/setup.sh"
  ],
  "parallel_checks": true,
  "checks": [
    {
      "name": "build",
      "run": "scripts/build.sh",
      "timeout_minutes": 10,
      "group": "fast"
    },
    {
      "name": "lint",
      "run": "scripts/lint.sh",
      "timeout_minutes": 10,
      "group": "fast"
    },
    {
      "name": "test",
      "run": "scripts/test.sh",
      "timeout_minutes": 20,
      "results": [
        "artifacts/test-results"
      ],
      "group": "fast"
    },
    {
      "name": "integration",
      "run": "scripts/integration.sh",
      "timeout_minutes": 30,
      "slow": true,
      "results": [
        "artifacts/test-results"
      ]
    },
    {
      "name": "e2e",
      "run": "scripts/e2e.sh",
      "timeout_minutes": 40,
      "slow": true,
      "results": [
        "artifacts/test-results",
        "artifacts/logs",
        "tests/e2e/test-results"
      ]
    }
  ],
  "cache": [
    {
      "name": "nuget",
      "paths": [
        "~/.nuget/packages"
      ],
      "key_files": [
        "Directory.Packages.props",
        "**/*.csproj",
        ".config/dotnet-tools.json"
      ]
    },
    {
      "name": "npm",
      "paths": [
        "~/.npm"
      ],
      "key_files": [
        "web/package-lock.json",
        "tests/e2e/package-lock.json"
      ]
    },
    {
      "name": "playwright",
      "paths": [
        "~/.cache/ms-playwright"
      ],
      "key_files": [
        "tests/e2e/package-lock.json"
      ]
    }
  ],
  "stages": {
    "plan": {
      "timeout_minutes": 20
    },
    "implement": {
      "timeout_minutes": 45
    },
    "review": {
      "timeout_minutes": 25
    },
    "triage": {
      "model": "claude-opus-5-5"
    }
  },
  "default_profile": "hard",
  "profiles": {
    "standard": {
      "when": "Only work that repeats what the platform already does, in the same way: a change to docs or tests only, a sample or configuration file shaped like an existing one, or a change to an existing screen, endpoint or command that adds no new kind of component, library or pattern. A mistake could not reach stored data, access, security or running work. Anything else is hard.",
      "stages": {
        "plan": {
          "model": "claude-opus-5-5"
        },
        "implement": {
          "model": "claude-haiku-5-5"
        },
        "review": {
          "agent": "claude",
          "model": "claude-opus-5-5"
        }
      }
    },
    "hard": {
      "when": "Everything that is not standard. That covers a mistake that could leak data across tenants or users, lose or corrupt stored data, change how running work or an active release behaves, or weaken security, for example around tenants, roles and policies, rules used for authorization, entity storage and schema changes, releases and activation, processes, connectors and secrets. It also covers work that brings a kind of component, editor, library or pattern the platform does not have yet, and a request that depends on a decision that is still Proposed. When unsure between standard and hard, choose hard.",
      "stages": {
        "plan": {
          "model": "claude-opus-5-5"
        },
        "implement": {
          "model": "claude-sonnet-5-5",
          "timeout_minutes": 60
        },
        "review": {
          "agent": "claude",
          "model": "claude-opus-5-5"
        }
      }
    }
  },
  "fix": {
    "max_auto_rounds": 2
  },
  "merge": {
    "auto": true,
    "after_workflows": [
      "ci.yml",
      "codeql.yml",
      "performance.yml"
    ]
  },
  "conflicts": {
    "auto_resolve": true,
    "max_rounds": 6
  },
  "close_parent_issues": true,
  "autopilot": {
    "enabled": true,
    "scope": null,
    "answer": "recommended"
  },
  "evidence": {
    "artifacts": [
      "test-results-e2e-1",
      "test-results-e2e-2",
      "test-results-e2e-3",
      "test-results-integration",
      "test-results-performance",
      "test-results-unit"
    ]
  },
  "notify": [
    "phuongnse"
  ]
}
