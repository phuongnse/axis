{
  "version": 1,
  "agents": {
    "claude": {
      "runtime": "claude-code",
      "provider": "anthropic",
      "oauth_token_secret": "CLAUDE_CODE_OAUTH_TOKEN",
      "fallback": [
        "claude-fallback"
      ]
    },
    "claude-fallback": {
      "runtime": "claude-code",
      "provider": "anthropic",
      "oauth_token_secret": "CLAUDE_FALLBACK_OAUTH_TOKEN"
    }
  },
  "model": "claude-opus-5-5",
  "effort": "high",
  "setup": [
    "scripts/setup.sh"
  ],
  "parallel_checks": true,
  "checks": [
    {
      "name": "build",
      "run": "scripts/build.sh",
      "timeout_minutes": 10,
      "group": "build-lint"
    },
    {
      "name": "lint",
      "run": "scripts/lint.sh",
      "timeout_minutes": 10,
      "group": "build-lint"
    },
    {
      "name": "test",
      "run": "scripts/test.sh",
      "timeout_minutes": 20,
      "results": [
        "artifacts/test-results"
      ]
    },
    {
      "name": "smoke",
      "run": "scripts/smoke.sh",
      "timeout_minutes": 30,
      "slow": true,
      "results": [
        "artifacts/test-results"
      ],
      "unaffected_by": [
        "docs/**",
        ".github/**",
        ".nexkit/**",
        "**/*.md"
      ]
    },
    {
      "name": "integration-1",
      "run": "AXIS_INTEGRATION_SHARD=1/3 scripts/integration.sh",
      "timeout_minutes": 30,
      "slow": true,
      "results": [
        "artifacts/test-results"
      ],
      "unaffected_by": [
        "docs/**",
        ".github/**",
        ".nexkit/**",
        "tests/e2e/**",
        "web/**",
        "!web/package.json",
        "!web/package-lock.json",
        "!web/keycloak-theme/**",
        "!web/vite.config.ts",
        "!web/vite.keycloak-theme.config.ts",
        "**/*.md"
      ]
    },
    {
      "name": "integration-2",
      "run": "AXIS_INTEGRATION_SHARD=2/3 scripts/integration.sh",
      "timeout_minutes": 30,
      "slow": true,
      "results": [
        "artifacts/test-results"
      ],
      "unaffected_by": [
        "docs/**",
        ".github/**",
        ".nexkit/**",
        "tests/e2e/**",
        "web/**",
        "!web/package.json",
        "!web/package-lock.json",
        "!web/keycloak-theme/**",
        "!web/vite.config.ts",
        "!web/vite.keycloak-theme.config.ts",
        "**/*.md"
      ]
    },
    {
      "name": "integration-3",
      "run": "AXIS_INTEGRATION_SHARD=3/3 scripts/integration.sh",
      "timeout_minutes": 30,
      "slow": true,
      "results": [
        "artifacts/test-results"
      ],
      "unaffected_by": [
        "docs/**",
        ".github/**",
        ".nexkit/**",
        "tests/e2e/**",
        "web/**",
        "!web/package.json",
        "!web/package-lock.json",
        "!web/keycloak-theme/**",
        "!web/vite.config.ts",
        "!web/vite.keycloak-theme.config.ts",
        "**/*.md"
      ]
    },
    {
      "name": "e2e-1",
      "run": "AXIS_E2E_SHARD=1/3 scripts/e2e.sh",
      "timeout_minutes": 30,
      "slow": true,
      "results": [
        "artifacts/test-results",
        "artifacts/logs",
        "tests/e2e/test-results"
      ],
      "unaffected_by": [
        "docs/**",
        ".github/**",
        ".nexkit/**",
        "**/*.md"
      ]
    },
    {
      "name": "e2e-2",
      "run": "AXIS_E2E_SHARD=2/3 scripts/e2e.sh",
      "timeout_minutes": 30,
      "slow": true,
      "results": [
        "artifacts/test-results",
        "artifacts/logs",
        "tests/e2e/test-results"
      ],
      "unaffected_by": [
        "docs/**",
        ".github/**",
        ".nexkit/**",
        "**/*.md"
      ]
    },
    {
      "name": "e2e-3",
      "run": "AXIS_E2E_SHARD=3/3 scripts/e2e.sh",
      "timeout_minutes": 30,
      "slow": true,
      "results": [
        "artifacts/test-results",
        "artifacts/logs",
        "tests/e2e/test-results"
      ],
      "unaffected_by": [
        "docs/**",
        ".github/**",
        ".nexkit/**",
        "**/*.md"
      ]
    }
  ],
  "cache": [
    {
      "name": "nuget",
      "paths": [
        "~/.nuget/packages"
      ],
      "key_files": [
        "Directory.Packages.props",
        "**/*.csproj",
        ".config/dotnet-tools.json"
      ]
    },
    {
      "name": "npm",
      "paths": [
        "~/.npm"
      ],
      "key_files": [
        "web/package-lock.json",
        "tests/e2e/package-lock.json"
      ]
    },
    {
      "name": "playwright",
      "paths": [
        "~/.cache/ms-playwright"
      ],
      "key_files": [
        "tests/e2e/package-lock.json"
      ]
    }
  ],
  "stages": {
    "plan": {
      "timeout_minutes": 20
    },
    "implement": {
      "timeout_minutes": 45
    },
    "review": {
      "timeout_minutes": 25
    },
    "triage": {
      "model": "claude-opus-5-5"
    }
  },
  "default_profile": "hard",
  "profiles": {
    "standard": {
      "when": "Only work that repeats what the platform already does, in the same way: a change to docs or tests only, a sample or configuration file shaped like an existing one, or a change to an existing screen, endpoint or command that adds no new kind of component, library or pattern. A mistake could not reach stored data, access, security or running work. Anything else is hard.",
      "stages": {
        "plan": {
          "model": "claude-opus-5-5"
        },
        "implement": {
          "model": "claude-haiku-5-5"
        },
        "review": {
          "agent": "claude",
          "model": "claude-opus-5-5"
        }
      }
    },
    "hard": {
      "when": "Everything that is not standard. That covers a mistake that could leak data across tenants or users, lose or corrupt stored data, change how running work or an active release behaves, or weaken security, for example around tenants, roles and policies, rules used for authorization, entity storage and schema changes, releases and activation, processes, connectors and secrets. It also covers work that brings a kind of component, editor, library or pattern the platform does not have yet, and a request that depends on a decision that is still Proposed. When unsure between standard and hard, choose hard.",
      "stages": {
        "plan": {
          "model": "claude-opus-5-5"
        },
        "implement": {
          "model": "claude-sonnet-5-5",
          "timeout_minutes": 60
        },
        "review": {
          "agent": "claude",
          "model": "claude-opus-5-5"
        }
      }
    }
  },
  "fix": {
    "max_auto_rounds": 2
  },
  "merge": {
    "auto": true,
    "after_workflows": [
      {
        "workflow": "ci.yml",
        "every": 5
      },
      {
        "workflow": "codeql.yml",
        "every": 32
      },
      {
        "workflow": "performance.yml",
        "every": 62
      },
      {
        "workflow": "docs-audit.yml",
        "every": 100
      }
    ]
  },
  "conflicts": {
    "auto_resolve": true,
    "max_rounds": 6
  },
  "close_parent_issues": true,
  "autopilot": {
    "enabled": true,
    "scope": null,
    "answer": "recommended",
    "max_parallel": 3,
    "watch_workflows": [],
    "trusted_workflows": [
      "docs-audit.yml"
    ],
    "priority": [
      "nexkit:ci",
      "nexkit:dependabot",
      "bug",
      "nexkit:flaky",
      "process"
    ],
    "labels": {
      "journey": {
        "wave": 1
      },
      "docs-sweep": {
        "wave": 2
      },
      "on-hold": {
        "hold": true
      }
    },
    "dependabot": "high"
  },
  "evidence": {
    "artifacts": [
      "test-results-e2e-1",
      "test-results-e2e-2",
      "test-results-e2e-3",
      "test-results-integration-1",
      "test-results-integration-2",
      "test-results-integration-3",
      "test-results-performance",
      "test-results-smoke",
      "test-results-test"
    ]
  },
  "notify": [
    "phuongnse"
  ],
  "review": {
    "checklist": [
      "The change leaves no doc statement false: what changed is rewritten where it is described, the rule it replaces is deleted, the planned marker of what it builds is removed, and no name it renames or removes is still named under docs/, in AGENTS.md or under .claude/skills/",
      "Each rule the change touches is stated in one place, and any other place, AGENTS.md included, only links to it in a sentence",
      "The docs diff adds no progress, history, dates, milestone or issue numbers",
      "An Agreed decision changes only in wording or links: a change to its choice is a new decision that supersedes it whole",
      "A doc list of what the code defines that the change adds or extends has a unit test that reads the list from the doc and from the code and compares them",
      "A change that adds a new kind of route, host, caller, stored secret or integration updates docs/reference/threat-model.md",
      "The change adds no exception to a check and loosens none: no new entry in an accepted list or rise of a baseline count, and no rule removed, narrowed or skipped in a check script under scripts/ or its test",
      "No test or check names something that was removed: a removal deletes the thing and its tests, and a rule against a kind of mistake is stated as the current rule, never as a list of removed names"
    ]
  },
  "github_app": {
    "slug": "nexkit-agent",
    "app_id_secret": "NEXKIT_APP_ID",
    "private_key_secret": "NEXKIT_APP_PRIVATE_KEY"
  }
}
