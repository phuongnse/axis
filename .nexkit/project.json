{
  "default_branch": "main",
  "defaults": {
    "application": "absent",
    "decisions": [
      "Build a modern enterprise application platform for user-defined data structures and business processes.",
      "Architecture, technology choices and the first implementation scope remain open.",
      "Use the dedicated VPS runner with this consumer's independent ChatGPT subscription login.",
      "Use gpt-6.1-sol and max reasoning for every configured agent invocation.",
      "Require authorized collaborator specification approval before read-only discovery.",
      "Use the supplied NexKit runtime and reusable workflows without consumer compatibility patches.",
      "Configure application delivery only after architecture and real application tests and end-to-end checks are established.",
      "Use separate discovery, delivery and release pipelines with bounded per-pipeline budgets.",
      "Require one current authorized collaborator PR approval after all candidate checks and independent AI review; Request changes starts bounded repair.",
      "Invalidate candidate approvals after changes; release only an explicitly approved immutable commit and version.",
      "Keep application delivery and release blocked before reservation until architecture, application verification commands and release outputs are established.",
      "Keep Axis issues self-contained without unrelated project names, paths or references."
    ],
    "environment": {
      "runner": "ubuntu-24.04",
      "setup": []
    },
    "issue_completion": {
      "close_after_merge": true,
      "close_after_release": true
    },
    "knowledge": [
      "README.md",
      "docs/product-brief.md",
      "docs/runner-operations.md",
      "docs/pipeline.md"
    ],
    "release": {
      "enabled": false
    }
