{
  "default_branch": "main",
  "defaults": {
    "application": "absent",
    "clarification": {
      "agent_minutes": 10,
      "max_calls": 3
    },
    "decisions": [
      "Build a modern enterprise application platform for user-defined data structures and business processes.",
      "Architecture, technology choices and the first implementation scope remain open.",
      "Use the dedicated VPS runner with this consumer's independent ChatGPT subscription login.",
      "Use gpt-6.1-sol and max reasoning for every configured agent invocation.",
      "Require authorized collaborator specification approval before read-only discovery.",
      "Retain the accepted bounded usage: three ten-minute clarification calls; two fifteen-minute analysis calls across at most two attempts within forty-five minutes.",
      "Use the supplied NexKit runtime and reusable workflows without consumer compatibility patches.",
      "Configure application delivery only after architecture and real application tests and end-to-end checks are established."
    ],
    "engine": {
      "auth": "chatgpt",
      "install": {
        "version": "0.160.0"
      },
      "name": "codex"
    },
    "environment": {
      "agent_runner": [
        "self-hosted",
        "linux",
        "x64",
        "axis-runner"
      ],
      "runner": "ubuntu-24.04",
      "setup": []
    },
    "knowledge": [
      "README.md",
      "docs/product-brief.md",
      "docs/runner-operations.md"
    ],
    "limits": {
      "agent_calls": 2,
      "attempts": 2,
      "command_seconds": 120,
      "minutes": 45
    },
    "models": {
      "implement": "gpt-6.1-sol"
    },
    "reasoning_effort": {
      "implement": "max"
    },
    "release": {
      "enabled": false
    }
