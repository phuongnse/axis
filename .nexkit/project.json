        "tasks": ".github/workflows/nexkit-discovery.yml"
      },
      "invocations": {
        "analyze": {
          "contract": "task",
          "minutes": 15,
          "model": "gpt-6.1-sol",
          "reasoning_effort": "max",
          "required": true,
          "task": ".nexkit/controls/platform-discovery.md"
        }
      },
