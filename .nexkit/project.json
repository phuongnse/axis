  "kit": {
    "ref": "12135708fa35d7471a4127b9a8aaf4c19d834ebd",
    "repository": "phuongnse/nexkit",
    "version": "1.1.0"
  },
  "pipelines": {
    "delivery": {
      "agent_workflows": [
        ".github/workflows/nexkit-clarify.yml",
        ".github/workflows/nexkit-discovery.yml",
        ".github/workflows/nexkit-runner-probe.yml",
        ".github/workflows/nexkit-delivery-clarify.yml",
        ".github/workflows/nexkit-delivery.yml"
      ],
      "approvals": {
        "pr-review": {
          "continuation": ".github/workflows/nexkit-pr-continuation.yml",
          "enabled": true,
          "minimum": 1,
          "mode": "pull_request",
          "on_rejection": "retry",
          "protects": [
            "merge"
          ],
          "reviewers": "repository",
          "subject": "candidate",
          "wait_minutes": 10080
        }
      },
      "entrypoints": {
        "clarify": ".github/workflows/nexkit-delivery-clarify.yml",
        "delivery": ".github/workflows/nexkit-delivery.yml",
        "intake": ".github/workflows/nexkit-intake.yml"
      },
      "invocations": {
        "implement": {
          "contract": "deliver",
          "minutes": 30,
          "model": "gpt-6.1-sol",
          "reasoning_effort": "max",
          "required": true,
          "task": ".nexkit/controls/delivery-change.md"
        },
        "plan": {
          "contract": "task",
          "minutes": 15,
          "model": "gpt-6.1-sol",
          "reasoning_effort": "max",
          "required": true,
          "task": ".nexkit/controls/delivery-plan.md"
        },
        "review": {
          "contract": "review",
          "minutes": 15,
          "model": "gpt-6.1-sol",
          "reasoning_effort": "max",
          "required": true,
          "task": ".nexkit/controls/delivery-review.md"
        }
      },
      "settings": {
        "application": "absent",
        "checks": [],
        "clarification": {
          "agent_minutes": 30,
          "max_calls": 3
        },
        "engine": {
          "auth": "chatgpt",
          "install": {
            "version": "0.160.0"
          },
          "name": "codex"
        },
        "environment": {
          "agent_runner": [
            "self-hosted",
            "linux",
            "x64",
            "axis-runner"
          ]
        },
        "limits": {
          "agent_calls": 9,
          "attempts": 3,
          "command_seconds": 900,
          "minutes": 120
        },
        "merge_method": "squash",
        "models": {
          "implement": "gpt-6.1-sol",
          "review": "gpt-6.1-sol"
        },
        "reasoning_effort": {
          "implement": "max",
          "review": "max"
        }
      }
    },
    "discovery": {
