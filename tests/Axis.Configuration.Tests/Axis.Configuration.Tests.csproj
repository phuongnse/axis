<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Axis.Configuration\Axis.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Axis.Expressions\Axis.Expressions.csproj" />
    <ProjectReference Include="..\..\src\Axis.Policy\Axis.Policy.csproj" />
    <ProjectReference Include="..\Axis.LoadData\Axis.LoadData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\apps\purchase-requests\**\*" Link="Samples\purchase-requests\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\apps\leave-requests\**\*" Link="Samples\leave-requests\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\apps\service-desk\**\*" Link="Samples\service-desk\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\apps\asset-management\**\*" Link="Samples\asset-management\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\modules\departments\**\*" Link="SampleModules\departments\1.0.0\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\e2e\fixtures\modules\checklists\**\*" Link="FixtureModules\checklists\1.0.0\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\templates\request-approval\**\*" Link="SampleTemplates\request-approval\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\e2e\fixtures\e2e-app\**\*" Link="Fixtures\e2e-app\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\e2e\fixtures\subprocess-app\**\*" Link="Fixtures\subprocess-app\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\e2e\fixtures\host-site-app\**\*" Link="Fixtures\host-site-app\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\e2e\fixtures\module-app\**\*" Link="Fixtures\module-app\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\**\*.md" Link="Docs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\packages\TestPackages.targets" />
  <Import Project="..\..\samples\packages\SamplePackages.targets" />

</Project>
