{
  "id": "a7c3d1e4-5b2f-4e86-9a1d-3c8f6b2e4d06",
  "kind": "policy",
  "name": "ReportingAccess",
  "formatVersion": 1,
  "roles": ["reporting-system"],
  "grants": [
    { "name": "reportRead", "entity": "Report", "actions": ["read", "create", "update", "delete"], "filter": "status != 'hidden'" },
    { "name": "reportTitlesRead", "dataSource": "ReportTitles", "actions": ["read"] },
    { "name": "reviewStart", "process": "Review", "actions": ["start", "inspect"] },
    { "name": "publishStart", "process": "Publish", "actions": ["start", "inspect", "retry", "cancel", "resolve"] }
  ]
}
