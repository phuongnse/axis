{
  "id": "a5094310-7b7d-47f9-855e-587dcef6a156",
  "kind": "policy",
  "name": "FilteredAccess",
  "formatVersion": 1,
  "roles": ["filtered"],
  "grants": [
    { "entity": "Item", "actions": ["read"], "filter": "false" },
    { "entity": "Item", "actions": ["read"], "filter": "status is not null" },
    { "entity": "Item", "actions": ["create", "update", "delete"], "filter": "status == 'open'" },
    { "entity": "Ticket", "actions": ["read", "create", "update", "delete"], "filter": "requester == currentUser()" }
  ]
}
