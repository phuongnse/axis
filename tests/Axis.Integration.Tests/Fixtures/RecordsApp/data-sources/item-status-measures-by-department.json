{
  "id": "a8c4e0d7-2b19-4f63-8e5a-0d7c3b1f9e24",
  "kind": "dataSource",
  "name": "ItemStatusMeasuresByDepartment",
  "formatVersion": 1,
  "entity": "Item",
  "fields": [
    { "name": "departmentName", "path": "department.name" }
  ],
  "aggregate": {
    "groupBy": ["departmentName"],
    "measures": [
      { "name": "open", "function": "count", "filter": "status == 'open'" },
      { "name": "notOpen", "function": "count", "filter": "status != 'open'" }
    ]
  },
  "sort": "-notOpen"
}
