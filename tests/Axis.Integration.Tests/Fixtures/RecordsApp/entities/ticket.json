{
  "id": "15a608a6-8015-45b0-bc28-8c15d036722f",
  "kind": "entity",
  "name": "Ticket",
  "formatVersion": 1,
  "fields": [
    { "name": "number", "type": "text", "maxLength": 20, "unique": true, "sequence": "TicketNumber" },
    { "name": "title", "type": "text", "required": true, "maxLength": 100 },
    { "name": "code", "type": "text", "maxLength": 20, "unique": true },
    { "name": "priority", "type": "integer" },
    { "name": "dueAt", "type": "date-time" }
  ],
  "validations": [
    { "expression": "priority is null or priority > 0", "message": { "textKey": "ticket.priorityPositive" }, "field": "priority" },
    { "expression": "dueAt is null or dueAt > now()", "message": { "textKey": "ticket.dueInPast" }, "field": "dueAt" }
  ]
}
