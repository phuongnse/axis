{
  "id": "6adf408a-ed60-49f6-a685-6e5d07d46bad",
  "kind": "contract",
  "name": "RequestContract",
  "formatVersion": 1,
  "entity": "Request",
  "lifecycle": {
    "field": "status",
    "states": [
      { "name": "draft", "label": { "textKey": "signoffs.request.state.draft" }, "initial": true, "deletable": true },
      { "name": "submitted", "label": { "textKey": "signoffs.request.state.submitted" } },
      { "name": "approved", "label": { "textKey": "signoffs.request.state.approved" } }
    ],
    "transitions": [
      { "name": "submit", "label": { "textKey": "signoffs.request.transition.submit" }, "from": ["draft"], "to": "submitted" },
      {
        "name": "approve",
        "label": { "textKey": "signoffs.request.transition.approve" },
        "from": ["submitted"],
        "to": "approved",
        "guard": "accountableUser() != null and accountableUser() != requester"
      }
    ]
  }
}
