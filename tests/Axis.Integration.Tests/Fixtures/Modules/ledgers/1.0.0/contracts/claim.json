{
  "id": "aab47425-1481-4881-b10e-41da670115ea",
  "kind": "contract",
  "name": "ClaimContract",
  "formatVersion": 1,
  "entity": "Claim",
  "lifecycle": {
    "field": "status",
    "states": [{ "name": "draft", "label": { "textKey": "ledgers.claim.state.draft" }, "initial": true, "deletable": true }, { "name": "submitted", "label": { "textKey": "ledgers.claim.state.submitted" } }, { "name": "approved", "label": { "textKey": "ledgers.claim.state.approved" } }],
    "transitions": [
      { "name": "submit", "label": { "textKey": "ledgers.claim.transition.submit" }, "from": ["draft"], "to": "submitted" },
      { "name": "approve", "label": { "textKey": "ledgers.claim.transition.approve" }, "from": ["submitted"], "to": "approved" }
    ]
  },
  "effects": [
    {
      "name": "entryRecorded",
      "label": { "textKey": "ledgers.claim.effect.entryRecorded" },
      "on": "approve",
      "create": {
        "entity": "Entry",
        "values": { "claim": "id", "amount": "amount", "status": "'open'" }
      }
    }
  ]
}
