{
  "id": "e4a82c96-1f07-4b3d-b5c8-6a9d3e1f7b04",
  "kind": "contract",
  "name": "TicketContract",
  "formatVersion": 1,
  "entity": "Ticket",
  "lifecycle": {
    "field": "status",
    "states": [{ "name": "draft", "label": { "textKey": "stages.ticket.state.draft" }, "initial": true, "deletable": true }, { "name": "submitted", "label": { "textKey": "stages.ticket.state.submitted" } }],
    "transitions": [{ "name": "submit", "label": { "textKey": "stages.ticket.transition.submit" }, "from": ["draft"], "to": "submitted" }]
  },
  "validations": [
    {
      "name": "amountFrozenAfterSubmit",
      "label": { "textKey": "stages.ticket.validation.amountFrozenAfterSubmit" },
      "expression": "previous(status) == null or previous(status) == 'draft' or amount == previous(amount)",
      "message": { "textKey": "stages.ticket.amountFrozen" },
      "field": "amount"
    },
    {
      "name": "stepMovesWithNewDecision",
      "label": { "textKey": "stages.ticket.validation.stepMovesWithNewDecision" },
      "expression": "previous(status) == null or step == previous(step) or stepDecision != previous(stepDecision)",
      "message": { "textKey": "stages.ticket.stepNeedsDecision" },
      "field": "step"
    }
  ]
}
