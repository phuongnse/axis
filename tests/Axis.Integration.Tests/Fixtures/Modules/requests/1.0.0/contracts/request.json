{
  "id": "4d2a6c81-3e5b-4f70-8a1c-9b0d2e4f6a02",
  "kind": "contract",
  "name": "RequestContract",
  "formatVersion": 1,
  "entity": "Request",
  "lifecycle": {
    "field": "status",
    "states": [
      { "name": "draft", "label": { "textKey": "requests.request.state.draft" }, "initial": true, "deletable": true },
      { "name": "submitted", "label": { "textKey": "requests.request.state.submitted" } },
      { "name": "approved", "label": { "textKey": "requests.request.state.approved" }, "protected": true },
      { "name": "archived", "label": { "textKey": "requests.request.state.archived" }, "deletable": true }
    ],
    "transitions": [
      {
        "name": "submit",
        "label": { "textKey": "requests.request.transition.submit" },
        "from": ["draft"],
        "to": "submitted",
        "guard": "amount > 0",
        "message": { "textKey": "requests.request.amountRequired" }
      },
      { "name": "approve", "label": { "textKey": "requests.request.transition.approve" }, "from": ["submitted"], "to": "approved", "guard": "100 / amount > 0 and previous(amount) == amount" },
      { "name": "archive", "label": { "textKey": "requests.request.transition.archive" }, "from": ["approved"], "to": "archived" }
    ]
  }
}
