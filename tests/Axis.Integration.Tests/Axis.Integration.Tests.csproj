<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Testcontainers.Keycloak" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Axis.Admin\Axis.Admin.csproj" />
    <ProjectReference Include="..\..\src\Axis.Configuration\Axis.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Axis.Data\Axis.Data.csproj" />
    <ProjectReference Include="..\..\src\Axis.Processes\Axis.Processes.csproj" />
    <ProjectReference Include="..\..\src\Axis.Scenarios\Axis.Scenarios.csproj" />
    <ProjectReference Include="..\..\src\Axis.Server\Axis.Server.csproj" />
    <ProjectReference Include="..\..\src\Axis.Worker\Axis.Worker.csproj" />
    <ProjectReference Include="..\Axis.PurchasingStub\Axis.PurchasingStub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Axis.Configuration.Tests\ModelAssert.cs" Link="ModelAssert.cs" />
    <Compile Include="..\Axis.Configuration.Tests\TemporaryFolder.cs" Link="TemporaryFolder.cs" />
    <Compile Include="..\Axis.Configuration.Tests\SamplePackages.cs" Link="SamplePackages.cs" />
    <Compile Include="..\Axis.Configuration.Tests\TestPackages.cs" Link="TestPackages.cs" />
    <Compile Include="..\Axis.Data.Tests\Models.cs" Link="Models.cs" />
    <Compile Include="..\Axis.Server.Tests\TestAuthentication.cs" Link="TestAuthentication.cs" />
    <Compile Include="..\Axis.Server.Tests\TestEndpointCallers.cs" Link="TestEndpointCallers.cs" />
    <Compile Include="..\Axis.Server.Tests\TestOidc.cs" Link="TestOidc.cs" />
    <Compile Include="..\Axis.Server.Tests\TestPlatformMigration.cs" Link="TestPlatformMigration.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\apps\purchase-requests\**\*" Link="Samples\purchase-requests\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\apps\leave-requests\**\*" Link="Samples\leave-requests\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\modules\departments\**\*" Link="SampleModules\departments\1.0.0\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\keycloak\axis-realm.json" Link="Keycloak\axis-realm.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\packages\TestPackages.targets" />
  <Import Project="..\..\samples\packages\SamplePackages.targets" />

</Project>
