{
  "id": "3c8f1e52-6a0d-4b7e-9f21-5d4c3b2a1e09",
  "kind": "process",
  "name": "NoteClose",
  "formatVersion": 1,
  "entity": "Note",
  "startCondition": {
    "expression": "status is null or status == 'open'",
    "message": { "textKey": "noteClose.cannotClose" }
  },
  "start": "close",
  "steps": [
    {
      "name": "close",
      "type": "operation",
      "operation": "updateRecord",
      "set": { "status": "'closed'" },
      "next": "end"
    },
    { "name": "end", "type": "end" }
  ]
}
