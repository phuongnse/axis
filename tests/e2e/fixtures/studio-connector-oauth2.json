{
  "id": "5d1f0a2e-7c3b-4e6a-9b48-2f6c1d8e0a37",
  "kind": "connector",
  "name": "WarehouseShipping",
  "formatVersion": 1,
  "baseUrl": { "binding": "ShippingUrl" },
  "auth": {
    "type": "oauth2",
    "tokenUrl": { "binding": "ShippingTokenUrl" },
    "clientId": { "binding": "ShippingClientId" },
    "clientSecret": { "binding": "ShippingClientSecret" },
    "scope": "shipments.write"
  },
  "operations": [
    {
      "name": "createShipment",
      "method": "POST",
      "path": "/warehouses/{warehouse}/shipments",
      "input": [
        { "name": "warehouse", "type": "text", "required": true, "in": "path" },
        { "name": "dryRun", "type": "boolean", "in": "query" },
        {
          "name": "lines",
          "type": "list",
          "fields": [
            { "name": "sku", "type": "text", "required": true },
            { "name": "quantity", "type": "integer", "required": true }
          ]
        }
      ],
      "output": [{ "name": "trackingNumber", "type": "text", "source": "/shipment/tracking/number" }]
    }
  ]
}
