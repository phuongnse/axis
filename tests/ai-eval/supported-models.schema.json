{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supported models of the authoring eval",
  "description": "The models that passed the authoring eval, with the date and Axis version of their last pass. See docs/reference/model-bindings.md#the-authoring-eval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["models"],
  "properties": {
    "$schema": { "type": "string" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "model", "date", "axisVersion"],
        "properties": {
          "kind": { "enum": ["anthropic", "openai-compatible"] },
          "model": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "axisVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" }
        }
      }
    }
  }
}
