{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoring eval case",
  "description": "One case of the authoring eval: a starting application, the request text and the expected outcome. See docs/reference/model-bindings.md#the-authoring-eval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["start", "request", "outcome"],
  "properties": {
    "$schema": { "type": "string" },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "name"],
      "properties": {
        "from": { "enum": ["application", "sample", "template"] },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      }
    },
    "request": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "outcome": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["change", "refusal"] } },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "change" } } }, "then": { "$ref": "#/$defs/change" } },
        { "if": { "properties": { "kind": { "const": "refusal" } } }, "then": { "$ref": "#/$defs/refusal" } }
      ]
    }
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scenarios"],
      "properties": {
        "kind": { "const": "change" },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unchanged": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "module", "point"],
      "properties": {
        "kind": { "const": "refusal" },
        "module": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "point": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*/[A-Za-z]+(/[A-Za-z0-9-]+){1,2}$" }
      }
    }
  }
}
