<Project Sdk="Microsoft.NET.Sdk">

  <!-- A test-only extension package whose module initializer and operation's static constructor write marker files, to show that a host only runs the package code it means to. -->
  <PropertyGroup>
    <AssemblyName>Axis.InitializerPackage</AssemblyName>
    <RootNamespace>InitializerPackage</RootNamespace>
    <Version>1.0.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not copied: the host shares its own Axis.Extensions with every package. -->
    <ProjectReference Include="..\..\..\src\Axis.Extensions\Axis.Extensions.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="axis-package.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
