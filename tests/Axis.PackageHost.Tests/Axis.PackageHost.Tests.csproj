<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Axis.PackageHost\Axis.PackageHost.csproj" />
    <ProjectReference Include="..\..\src\Axis.Configuration\Axis.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Axis.Configuration.Tests\TemporaryFolder.cs" Link="TemporaryFolder.cs" />
    <Compile Include="..\Axis.Configuration.Tests\TestPackages.cs" Link="TestPackages.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\packages\node-test-package\**\*" Exclude="..\packages\node-test-package\node_modules\**" LinkBase="NodeTestPackage" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\packages\PythonPackage\**\*" LinkBase="PythonPackage" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\packages\node-probe-package\**\*" LinkBase="NodeProbePackage" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sdk\node\**\*" LinkBase="sdk/node" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\sdk\python\**\*" Exclude="..\..\sdk\python\**\__pycache__\**" LinkBase="sdk/python" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sdk\package-runner-protocol.schema.json" Link="package-runner-protocol.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\packages\TestPackages.targets" />

</Project>
