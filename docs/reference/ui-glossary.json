{
  "$comment": "The terms Axis's own screens use for each concept, by locale. See docs/reference/ui-writing.md. status: approved, proposed or decide.",
  "locales": [
    "en",
    "vi"
  ],
  "keep": {
    "names": [
      "API",
      "AXC codes such as AXC0035",
      "Axis",
      "CSV",
      "HTML",
      "ID",
      "JSON",
      "names an author gave",
      "PDF",
      "PIN",
      "placeholders such as {count}",
      "Studio",
      "TOTP",
      "URL",
      "XLSX",
      "ZIP"
    ],
    "integration": [
      "webhook",
      "endpoint",
      "tenant",
      "token",
      "API key"
    ],
    "$comment": "names never change in any locale. integration terms stay in English and show only on integration and operator screens."
  },
