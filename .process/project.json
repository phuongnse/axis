      {
        "id": "install-gh",
        "kind": "managed-tool",
        "tool": "gh",
        "timeoutSeconds": 300
      },
      {
        "id": "install-lychee",
        "kind": "managed-tool",
        "tool": "lychee",
        "timeoutSeconds": 300
      },
      {
        "id": "install-node",
        "kind": "managed-tool",
        "tool": "node",
        "timeoutSeconds": 600
      },
      {
        "id": "install-project-dependencies",
        "kind": "command",
        "run": [
          "python",
          "scripts/axis.py",
          "dependencies",
          "install"
        ],
        "timeoutSeconds": 1800,
        "mutations": [
          "network",
          "project-files",
          "user-files"
        ],
        "requires": [
          "install-dotnet",
          "install-node"
        ]
      }
