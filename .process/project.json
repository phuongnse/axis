{
  "schemaVersion": 3,
  "project": "axis",
  "lifecycle": {
    "requiredProfiles": [
      "development",
      "review"
    ]
  },
  "profiles": {
    "development": [
      {
        "id": "changed-path-verification",
        "run": [
          "python",
          "scripts/axis.py",
          "verify"
        ],
        "timeoutSeconds": 3600
      }
    ],
    "review": [
      {
        "id": "review-checks",
        "run": [
          "python",
          "scripts/axis.py",
          "review-checks",
          "--supplemental"
        ],
        "timeoutSeconds": 7200
      }
    ]
  },
  "environment": {
    "defaultProfile": "development",
    "foregroundOnly": true,
    "profiles": {
      "development": [
        "docker-engine",
        "dotnet-sdk",
        "git-runtime",
        "lychee-cli",
        "node-runtime",
        "npm-cli",
        "project-dependencies",
        "python-runtime"
      ],
      "publication": [
        "gh-cli",
        "git-runtime",
        "python-runtime"
      ],
      "review": [
        "docker-engine",
        "dotnet-sdk",
        "git-runtime",
        "lychee-cli",
        "node-runtime",
        "npm-cli",
        "project-dependencies",
        "python-runtime"
      ]
    },
    "requirements": [
      {
        "id": "docker-engine",
        "description": "Reachable Docker Engine and Docker Compose v2 required by selected integration, API, infrastructure, and browser tests",
        "probe": {
          "run": [
            "python",
            "scripts/axis.py",
            "check",
            "docker"
          ],
          "timeoutSeconds": 30,
          "readOnly": true
        },
        "remediation": "Install and start Docker Engine with a reachable daemon and Docker Compose v2, then rerun doctor."
      },
      {
        "id": "dotnet-sdk",
        "description": "Exact .NET SDK selected by the Axis toolchain contract",
        "probe": {
          "run": [
            "dotnet",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^10\\.0\\.302$"
        },
        "remediation": "Run processctl setup for the selected profile with network and user-files approval.",
        "setupAction": "install-dotnet"
      },
      {
        "id": "gh-cli",
        "description": "Exact GitHub CLI used by publication workflows",
        "probe": {
          "run": [
            "gh",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^gh version 2\\.96\\.0(?: |$)"
        },
        "remediation": "Run processctl setup for the publication profile with network and user-files approval.",
        "setupAction": "install-gh"
      },
      {
        "id": "git-runtime",
        "description": "Git command-line client required for lifecycle checkpoints and source provenance",
        "probe": {
          "run": [
            "git",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^git version 2\\.[0-9]+\\.[0-9]+"
        },
        "remediation": "Install a supported Git 2.x command-line client, then rerun doctor."
      },
      {
        "id": "lychee-cli",
        "description": "Exact Lychee release used by the offline Markdown link contract",
        "probe": {
          "run": [
            "lychee",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^lychee 0\\.23\\.0$"
        },
        "remediation": "Run processctl setup for the selected profile with network and user-files approval; macOS x64 and Windows arm64 require an externally installed exact release.",
        "setupAction": "install-lychee"
      },
      {
        "id": "node-runtime",
        "description": "Exact Node.js runtime selected by frontend/.nvmrc",
        "probe": {
          "run": [
            "node",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^v24\\.18\\.0$"
        },
        "remediation": "Run processctl setup for the selected profile with network and user-files approval.",
        "setupAction": "install-node"
      },
      {
        "id": "npm-cli",
        "description": "Exact npm CLI bound to the verified Node.js runtime",
        "probe": {
          "run": [
            "npm",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^11\\.16\\.0$"
        },
        "remediation": "Run processctl setup for the selected profile with network and user-files approval.",
        "setupAction": "install-node"
      },
      {
        "id": "project-dependencies",
        "description": "Locked NuGet and npm dependency graphs are restored for the current repository inputs",
        "probe": {
          "run": [
            "python",
            "scripts/axis.py",
            "check",
            "dependency-state"
          ],
          "timeoutSeconds": 30,
          "readOnly": true
        },
        "remediation": "Run processctl setup for the selected profile with network, project-files, and user-files approval.",
        "setupAction": "install-project-dependencies"
      },
      {
        "id": "python-runtime",
        "description": "CPython runtime used by the Axis repository command owner",
        "probe": {
          "run": [
            "python",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "combined",
          "outputRegex": "^Python 3\\.(?:11|12|13|14)\\."
        },
        "remediation": "Install a supported Python 3.11-3.14 runtime before running processctl."
      }
    ],
