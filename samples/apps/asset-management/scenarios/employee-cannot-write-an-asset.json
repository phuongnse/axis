{
  "id": "378dc972-35fc-4f62-992b-2a8cd80ebe33",
  "kind": "scenario",
  "name": "EmployeeCannotWriteAnAsset",
  "formatVersion": 1,
  "now": "2026-10-01T09:00:00Z",
  "users": {
    "asset-manager": [
      "asset-manager"
    ],
    "employee": [
      "employee"
    ]
  },
  "steps": [
    {
      "type": "createRecord",
      "entity": "Asset",
      "as": "asset-manager",
      "save": "lanAsset",
      "values": {
        "name": "Laptop of the employee",
        "holder": "employee",
        "status": "assigned"
      }
    },
    {
      "type": "createRecord",
      "entity": "Asset",
      "as": "asset-manager",
      "save": "annaAsset",
      "values": {
        "name": "Laptop of the requester",
        "holder": "requester",
        "status": "assigned"
      }
    },
    {
      "type": "updateRecord",
      "record": "annaAsset",
      "as": "employee",
      "values": {
        "name": "x"
      },
      "expect": "denied"
    },
    {
      "type": "updateRecord",
      "record": "lanAsset",
      "as": "employee",
      "values": {
        "name": "x"
      },
      "expect": "denied"
    },
    {
      "type": "createRecord",
      "entity": "Asset",
      "as": "employee",
      "values": {
        "name": "Own laptop"
      },
      "expect": "denied"
    },
    {
      "type": "expectRecord",
      "record": "annaAsset",
      "values": {
        "name": "Laptop of the requester"
      }
    }
  ]
