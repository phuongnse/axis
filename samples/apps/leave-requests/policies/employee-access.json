{
  "id": "9e32c2c7-c8bf-4df3-9ba9-04d2ea3f4f5c",
  "kind": "policy",
  "name": "EmployeeAccess",
  "formatVersion": 1,
  "roles": ["employee"],
  "grants": [
    { "name": "leaveRequestRead", "entity": "LeaveRequest", "actions": ["read"], "filter": "employee == currentUser()" },
    {
      "name": "leaveRequestCreate",
      "entity": "LeaveRequest",
      "actions": ["create", "update"],
      "filter": "employee == currentUser() and status in ('draft', 'returned')",
      "fields": ["title", "department", "leaveType", "firstDay", "lastDay", "reason", "status"]
    },
    { "name": "departmentRead", "entity": "departments/Department", "actions": ["read"] },
    { "name": "departmentsRead", "dataSource": "departments/Departments", "actions": ["read"] },
    { "name": "leaveRequestListRead", "dataSource": "LeaveRequestList", "actions": ["read"] },
    { "name": "leaveRequestApprovalStart", "process": "LeaveRequestApproval", "actions": ["start"] }
  ]
}
