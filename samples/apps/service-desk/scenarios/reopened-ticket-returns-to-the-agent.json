      }
    },
    {
      "type": "completeTask",
      "record": "ticket",
      "step": "resolve",
      "outcome": "resolve",
      "as": "agent",
      "values": {
        "resolution": "Replaced the battery."
      }
    },
    {
      "type": "completeTask",
      "record": "ticket",
