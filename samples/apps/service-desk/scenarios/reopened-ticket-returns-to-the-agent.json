{
  "id": "4822d97a-704c-4ac5-8b97-e9fb80db8587",
  "kind": "scenario",
  "name": "ReopenedTicketReturnsToTheAgent",
  "formatVersion": 1,
  "now": "2026-10-01T09:00:00Z",
