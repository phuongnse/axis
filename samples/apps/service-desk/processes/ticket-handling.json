{
  "id": "98f8e210-6ab5-4526-8c03-8d459bd2b38d",
  "kind": "process",
  "name": "TicketHandling",
  "formatVersion": 1,
  "entity": "Ticket",
  "startCondition": {
    "expression": "status == 'draft'",
    "message": {
      "textKey": "ticket.cannotSubmit"
    }
  },
  "start": "submit",
  "steps": [
    {
      "name": "submit",
      "type": "operation",
      "operation": "updateRecord",
      "set": {
        "status": "'submitted'"
      },
      "next": "triage"
    },
    {
      "name": "triage",
      "type": "task",
      "label": {
        "textKey": "ticket.triage"
      },
      "assignee": {
        "role": "service-desk-lead"
      },
      "form": "TicketTriage",
      "dueIn": "P1D",
      "outcomes": [
        {
          "name": "assign",
          "label": {
            "textKey": "task.assign"
          },
          "next": "markAssigned"
        },
        {
          "name": "reject",
          "label": {
            "textKey": "task.reject"
          },
          "next": "markRejected"
        }
      ]
    },
    {
      "name": "markAssigned",
      "type": "operation",
      "operation": "updateRecord",
      "set": {
        "status": "'assigned'",
        "assignedAgent": "coalesce(assignedAgent, category.defaultAgent)"
      },
      "next": "resolve"
    },
    {
      "name": "resolve",
      "type": "task",
      "label": {
        "textKey": "ticket.resolve"
      },
      "assignee": {
        "user": "assignedAgent"
      },
      "form": "TicketResolution",
      "dueIn": "P3D",
      "escalations": [
        {
          "name": "escalation1",
          "after": "P3D",
          "notify": {
            "to": [
              {
                "role": "service-desk-lead"
              }
            ],
            "channels": [
              "inApp"
            ],
            "message": {
              "subject": {
                "textKey": "ticket.late.subject"
              },
              "body": {
                "textKey": "ticket.late.body"
              },
              "values": {
                "number": "number"
              }
            }
          }
        },
        {
          "name": "escalation2",
          "after": "P4D",
          "reassign": {
            "role": "service-desk-lead"
          }
        },
        {
          "name": "escalation3",
          "after": "P3D",
          "notify": {
            "to": [
              {
                "user": "assignedAgent"
              }
            ],
            "channels": [
              "inApp",
              "email"
            ],
            "message": {
              "subject": {
                "textKey": "ticket.late.subject"
              },
              "body": {
                "textKey": "ticket.late.body"
              },
              "values": {
                "number": "number"
              }
            }
          }
        }
      ],
      "outcomes": [
        {
          "name": "resolve",
          "label": {
            "textKey": "task.resolve"
          },
          "next": "markResolved"
        }
      ]
    },
    {
      "name": "markResolved",
      "type": "operation",
      "operation": "updateRecord",
      "set": {
        "status": "'resolved'"
      },
      "next": "tellRequester"
    },
    {
      "name": "tellRequester",
      "type": "operation",
      "operation": "notify",
      "to": [
        {
          "user": "requester"
        }
      ],
      "channels": [
        "inApp",
        "email"
      ],
      "message": {
        "subject": {
          "textKey": "ticket.resolved.subject"
        },
        "body": {
          "textKey": "ticket.resolved.body"
        },
        "values": {
          "number": "number",
          "resolution": "resolution"
        }
      },
      "open": {
        "page": "TicketDetail",
        "parameters": {
          "ticket": "id"
        }
      },
      "next": "confirm"
    },
    {
      "name": "confirm",
      "type": "task",
      "label": {
        "textKey": "ticket.confirm"
      },
      "assignee": {
        "user": "requester"
      },
      "form": "TicketConfirmation",
      "dueIn": "P3D",
      "outcomes": [
        {
          "name": "confirm",
          "label": {
            "textKey": "task.confirm"
          },
          "next": "markClosed"
        },
        {
          "name": "reopen",
          "label": {
            "textKey": "task.reopen"
          },
          "next": "markAssigned"
        }
      ]
    },
    {
      "name": "markClosed",
      "type": "operation",
      "operation": "updateRecord",
      "set": {
        "status": "'closed'"
      },
      "next": "done"
    },
    {
      "name": "markRejected",
      "type": "operation",
      "operation": "updateRecord",
      "set": {
        "status": "'rejected'"
      },
      "next": "done"
    },
    {
      "name": "done",
      "type": "end"
    }
  ]
}
