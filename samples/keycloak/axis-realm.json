  "clientProfiles": {
    "profiles": [
      {
        "name": "axis-fapi2",
        "description": "FAPI 2.0 settings for the axis-fapi client",
        "executors": [
          {
            "executor": "pkce-enforcer",
            "configuration": {
              "auto-configure": "false"
            }
          },
          {
            "executor": "secure-client-authenticator",
            "configuration": {
              "allowed-client-authenticators": [
                "client-jwt"
              ],
              "default-client-authenticator": "client-jwt"
            }
          },
          {
            "executor": "secure-signature-algorithm-signed-jwt",
            "configuration": {
              "require-client-assertion": "true"
            }
          },
          {
            "executor": "dpop-bind-enforcer",
            "configuration": {
              "auto-configure": "false",
              "enforce-authorization-code-binding-to-dpop": "false"
            }
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "axis-fapi2-policy",
        "description": "Applies the axis-fapi2 profile to clients that hold the fapi2 role",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-roles",
            "configuration": {
              "type": "role",
              "roles": [
                "fapi2"
              ]
            }
          }
        ],
        "profiles": [
          "axis-fapi2"
        ]
      }
    ]
