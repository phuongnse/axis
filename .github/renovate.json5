{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchPrefix": "automation/renovate/",
  "commitMessageLowerCase": "never",
  "configMigration": true,
  "constraints": {
    "python": "==3.14"
  },
  "dependencyDashboard": true,
  "draftPR": true,
  "enabled": true,
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "npm",
    "nuget",
    "pip-compile"
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>phuongnse/engineering-process//templates/renovate#71bb94acb18aab41c97120f66e3cbd7c2fcee468"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "packageRules": [
    {
      "commitMessageTopic": "engineering-process",
      "description": "Adopt each published engineering-process release as a complete managed pull request.",
      "draftPR": true,
      "enabled": true,
      "groupName": "engineering-process",
      "groupSlug": "engineering-process",
      "matchFileNames": [
        "requirements/process.in",
        "requirements/process.txt"
      ],
      "matchPackageNames": [
        "engineering-process"
      ],
      "postUpgradeTasks": {
        "commands": [
          "python .process/adopt-process.py --project-root . --requirements-lock requirements/process.txt"
        ],
        "executionMode": "update",
        "fileFilters": [
          ".agents/skills/**",
          ".github/PULL_REQUEST_TEMPLATE.md",
          ".process/adopt-process.py",
          ".process/automation.json",
          ".process/adopt-process-windows-job.py",
          ".process/adoption-migrations/**",
          ".process/process.lock",
          ".process/project.json",
          "AGENTS.md"
        ],
        "installTools": {
          "python": {}
        }
      },
      "prPriority": 100,
      "schedule": [
        "at any time"
      ]
    },
    {
      "description": "Do not automate .NET SDK baseline changes.",
      "enabled": false,
      "matchFileNames": [
        "global.json"
      ]
    },
    {
      "description": "Keep the Node image aligned with the explicitly approved Node and bundled npm baseline.",
      "enabled": false,
      "matchFileNames": [
        "frontend/Dockerfile.dev"
      ]
    },
    {
      "description": "Do not update bundled npm independently from the Node baseline.",
      "enabled": false,
      "matchDepTypes": [
        "packageManager"
      ],
      "matchManagers": [
        "npm"
      ]
    },
    {
      "commitMessageTopic": ".NET packages",
      "description": "Group .NET package updates.",
      "groupName": ".NET packages",
      "groupSlug": "dotnet-packages",
      "matchFileNames": [
        "Directory.Packages.props",
        "**/*.csproj",
        "**/packages.lock.json",
        "dotnet-tools.json"
      ],
      "matchManagers": [
        "nuget"
      ]
    },
    {
      "commitMessageTopic": "frontend runtime dependencies",
      "description": "Group frontend runtime dependency updates.",
      "groupName": "frontend runtime dependencies",
      "groupSlug": "frontend-runtime",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchManagers": [
        "npm"
      ]
    },
    {
      "commitMessageTopic": "frontend tooling dependencies",
      "description": "Group frontend tooling dependency updates.",
      "groupName": "frontend tooling dependencies",
      "groupSlug": "frontend-tooling",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchManagers": [
        "npm"
      ]
    },
    {
      "commitMessageTopic": "GitHub Actions dependencies",
      "description": "Group GitHub Actions updates and preserve SHA pinning.",
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci"
    },
    {
      "commitMessageTopic": "container images",
      "description": "Group container image updates.",
      "groupName": "container images",
      "groupSlug": "container-images",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ]
    },
    {
      "dependencyDashboardApproval": true,
      "description": "Require dashboard approval before proposing separate major updates.",
      "groupName": null,
      "matchPackageNames": [
        "!engineering-process"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\/process\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "schedule": [
    "before 5am on monday"
  ],
  "semanticCommitScope": "deps",
  "semanticCommitType": "chore",
  "semanticCommits": "enabled",
  "timezone": "Asia/Ho_Chi_Minh",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "vulnerabilityFixStrategy": "lowest"
  }
}
