{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabled": true,
  "dependencyDashboard": true,
  "configMigration": true,
  "timezone": "Asia/Ho_Chi_Minh",
  "schedule": [
    "before 5am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "branchPrefix": "automation/renovate/",
  "draftPR": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageLowerCase": "never",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "npm",
    "nuget",
    "pip-compile"
  ],
  "rangeStrategy": "pin",
  "constraints": {
    "python": "==3.14"
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\/process\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "vulnerabilityFixStrategy": "lowest"
  },
  "prBodyTemplate": "<!-- engineering-process:pr-description:start -->\n## Summary\n\nRenovate proposes a dependency update for Axis version owners.\n\n{{{table}}}\n\n## Contract and scope\n\nDependency automation follows the exact version owners in docs/TECH_STACK.md.\n\n## Impact and risk\n\nThe proposed locked dependency delta requires CI and human compatibility review.\n\n## Verification\n\nProcess profiles and dependency audits run after this draft opens.\n\n## Independent review\n\nA human reviewer must approve the verified immutable checkpoint before merge.\n\n## Requirements and rules followed\n\n- [ ] **Scope and contract** — accepted scope is implemented without unapproved expansion. [status: pending]\n- [ ] **Verification evidence** — required current profiles pass on the published checkpoint. [status: pending]\n- [ ] **Independent review** — a separate reviewer approved the published checkpoint with no open required finding. [status: pending]\n<!-- engineering-process:pr-description:end -->\n\n## Project-specific requirements\n\n- [ ] **Project-specific: Documentation and status** — owning documentation and enforcement status are current when behavior, status, or workflow changes. [status: pending]\n- [x] **Project-specific: UI system** — [reason: dependency automation does not change an accepted UI surface until a separately reviewed implementation does so] [status: not-applicable]\n- [x] **Project-specific: Placeholder sweep** — generated Renovate text contains no implementation placeholder. [status: satisfied]\n",
  "packageRules": [
    {
      "description": "Adopt each published engineering-process release as a complete managed pull request.",
      "matchFileNames": [
        "requirements/process.in",
        "requirements/process.txt"
      ],
      "matchPackageNames": [
        "engineering-process"
      ],
      "enabled": true,
      "draftPR": true,
      "groupName": "engineering-process",
      "groupSlug": "engineering-process",
      "schedule": [
        "at any time"
      ],
      "prPriority": 100,
      "commitMessageTopic": "engineering-process",
      "postUpgradeTasks": {
        "commands": [
          "python .process/adopt-process.py --project-root . --requirements-lock requirements/process.txt"
        ],
        "fileFilters": [
          ".agents/skills/**",
          ".github/PULL_REQUEST_TEMPLATE.md",
          ".process/adopt-process.py",
          ".process/automation.json",
          ".process/adopt-process-windows-job.py",
          ".process/adoption-migrations/**",
          ".process/process.lock",
          ".process/project.json",
          "AGENTS.md"
        ],
        "executionMode": "update",
        "installTools": {
          "python": {}
        }
      }
    },
    {
      "description": "Do not automate .NET SDK baseline changes.",
      "matchFileNames": [
        "global.json"
      ],
      "enabled": false
    },
    {
      "description": "Keep the Node image aligned with the explicitly approved Node and bundled npm baseline.",
      "matchFileNames": [
        "frontend/Dockerfile.dev"
      ],
      "enabled": false
    },
    {
      "description": "Do not update bundled npm independently from the Node baseline.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "packageManager"
      ],
      "enabled": false
    },
    {
      "description": "Group .NET package updates.",
      "matchManagers": [
        "nuget"
      ],
      "matchFileNames": [
        "Directory.Packages.props",
        "**/*.csproj",
        "**/packages.lock.json",
        "dotnet-tools.json"
      ],
      "groupName": ".NET packages",
      "groupSlug": "dotnet-packages",
      "commitMessageTopic": ".NET packages"
    },
    {
      "description": "Group frontend runtime dependency updates.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "groupName": "frontend runtime dependencies",
      "groupSlug": "frontend-runtime",
      "commitMessageTopic": "frontend runtime dependencies"
    },
    {
      "description": "Group frontend tooling dependency updates.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "frontend tooling dependencies",
      "groupSlug": "frontend-tooling",
      "commitMessageTopic": "frontend tooling dependencies"
    },
    {
      "description": "Group GitHub Actions updates and preserve SHA pinning.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "semanticCommitType": "ci",
      "commitMessageTopic": "GitHub Actions dependencies"
    },
    {
      "description": "Group container image updates.",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "groupName": "container images",
      "groupSlug": "container-images",
      "commitMessageTopic": "container images"
    },
    {
      "description": "Require dashboard approval before proposing separate major updates.",
      "matchPackageNames": [
        "!engineering-process"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "dependencyDashboardApproval": true
    }
  ]
}
