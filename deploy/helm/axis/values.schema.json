{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "secretReference": {
      "type": "object",
      "description": "A reference to a key of an existing Kubernetes Secret. It never holds a value.",
      "properties": {
        "name": { "type": "string" },
        "key": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tlsSecretReference": {
      "type": "object",
      "description": "A reference to an existing Kubernetes TLS Secret, with the keys tls.crt and tls.key. It never holds a value.",
      "properties": {
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "volume": {
      "type": "object",
      "description": "Any Kubernetes volume source, or empty for none."
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" }
      }
    },
    "publisher": {
      "type": "object",
      "properties": {
        "resources": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "migrate": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "parallel": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    },
    "tenancy": {
      "type": "object",
      "properties": {
        "refreshInterval": { "type": "string" }
      }
    },
    "cell": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "region": { "type": "string" },
        "tenantDomain": { "type": "string" },
        "internalDomain": { "type": "string" },
        "tenantCap": { "type": ["string", "integer"] },
        "consoleHost": { "type": "string" },
        "consoleAllowedNetworks": { "type": "array", "items": { "type": "string" } },
        "internalUrl": { "type": "string" },
        "operatorRealm": { "type": "string" },
        "operatorRole": { "type": "string" },
        "backupKeyFile": { "type": "string" },
        "certificate": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" },
            "issuer": {
              "type": "object",
              "properties": {
                "server": { "type": "string" },
                "email": { "type": "string" },
                "dns01": {
                  "type": "object",
                  "properties": {
                    "provider": { "enum": ["cloudflare", "digitalocean"] },
                    "tokenSecret": { "$ref": "#/definitions/secretReference" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "http01": {
              "type": "object",
              "properties": {
                "ingressClassName": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "pgbouncer": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string" },
            "databaseHost": { "type": "string" },
            "databasePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "authUser": { "type": "string" },
            "authDatabase": { "type": "string" },
            "defaultPoolSize": { "type": "integer", "minimum": 1 },
            "maxDbConnections": { "type": "integer", "minimum": 1 },
            "maxClientConn": { "type": "integer", "minimum": 1 },
            "resources": { "type": "object" },
            "databaseAuthority": {
              "type": "object",
              "properties": { "volume": { "$ref": "#/definitions/volume" } }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "bucket": { "type": "string" },
        "serviceUrl": { "type": "string" },
        "region": { "type": "string" },
        "timeZone": { "type": "string" },
        "resources": { "type": "object" }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "properties": { "volume": { "$ref": "#/definitions/volume" } }
    },
    "modules": {
      "type": "object",
      "properties": { "volume": { "$ref": "#/definitions/volume" } }
    },
    "templates": {
      "type": "object",
      "properties": { "volume": { "$ref": "#/definitions/volume" } }
    },
    "studio": {
      "type": "object",
      "properties": {
        "folders": { "type": "array", "items": { "type": "string" } },
        "authorRole": { "type": "string" },
        "publisherRole": { "type": "string" },
        "persistence": { "$ref": "#/definitions/volume" },
        "tests": { "type": "boolean" }
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "hostname": { "type": "string" },
        "resources": { "type": "object" },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "theme": {
          "type": "object",
          "properties": { "volume": { "$ref": "#/definitions/volume" } }
        },
        "passwordBlacklists": {
          "type": "object",
          "properties": { "volume": { "$ref": "#/definitions/volume" } }
        },
        "databaseAuthority": {
          "type": "object",
          "properties": { "volume": { "$ref": "#/definitions/volume" } }
        }
      }
    },
    "forwardedHeaders": {
      "type": "object",
      "properties": {
        "knownProxies": { "type": "array", "items": { "type": "string" } },
        "knownNetworks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "platformConnection": { "$ref": "#/definitions/secretReference" },
        "platformSchemaConnection": { "$ref": "#/definitions/secretReference" },
        "platformSecretKey": { "$ref": "#/definitions/secretReference" },
        "serverCertificate": { "$ref": "#/definitions/tlsSecretReference" },
        "adminConnection": { "$ref": "#/definitions/secretReference" },
        "scenarioServerConnection": { "$ref": "#/definitions/secretReference" },
        "identityDatabaseUrl": { "$ref": "#/definitions/secretReference" },
        "identityDatabaseUsername": { "$ref": "#/definitions/secretReference" },
        "identityDatabasePassword": { "$ref": "#/definitions/secretReference" },
        "identityAdminClientSecret": { "$ref": "#/definitions/secretReference" },
        "identityCertificate": { "$ref": "#/definitions/tlsSecretReference" },
        "pgbouncerAuth": { "$ref": "#/definitions/secretReference" },
        "pgbouncerCertificate": { "$ref": "#/definitions/tlsSecretReference" },
        "backupStorageAccessKeyId": { "$ref": "#/definitions/secretReference" },
        "backupStorageSecretAccessKey": { "$ref": "#/definitions/secretReference" },
        "cellBackupKey": { "$ref": "#/definitions/secretReference" },
        "identityCredentialsConnection": { "$ref": "#/definitions/secretReference" }
      },
      "additionalProperties": false
    }
  }
}
