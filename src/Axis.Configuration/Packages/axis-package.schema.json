{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis extension package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "label", "lock", "operations"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 100 },
    "language": { "enum": ["csharp", "node", "python"] },
    "assembly": { "type": "string", "pattern": "^[^/\\\\]+\\.dll$" },
    "adapter": { "type": "string", "pattern": "^[^/\\\\]+$" },
    "lock": { "type": "string" },
    "runner": { "enum": ["axis", "customer"] },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "language": { "const": "node" } }, "required": ["language"] },
      "then": {
        "required": ["adapter"],
        "properties": {
          "assembly": false,
          "adapter": { "pattern": "\\.(js|mjs|cjs)$" },
          "lock": { "const": "package-lock.json" }
        }
      }
    },
    {
      "if": { "properties": { "language": { "const": "python" } }, "required": ["language"] },
      "then": {
        "required": ["adapter"],
        "properties": {
          "assembly": false,
          "adapter": { "pattern": "\\.py$" },
          "lock": { "const": "requirements.txt" }
        }
      }
    },
    {
      "if": { "properties": { "language": { "enum": ["node", "python"] } }, "required": ["language"] },
      "else": {
        "required": ["assembly"],
        "properties": { "adapter": false, "lock": { "const": "packages.lock.json" } }
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "idempotent"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "type": "string", "minLength": 1 },
        "idempotent": { "type": "boolean" },
        "timeout": { "type": "string" },
        "input": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "output": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "urls": { "type": "array", "items": { "$ref": "#/$defs/name" } },
            "secrets": { "type": "array", "items": { "$ref": "#/$defs/name" } }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "enum": ["text", "integer", "decimal", "boolean", "date", "date-time"] },
        "required": { "type": "boolean" }
      }
    }
  }
}
