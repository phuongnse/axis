{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis extension package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "assembly", "operations"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "assembly": { "type": "string", "pattern": "^[^/\\\\]+\\.dll$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "idempotent"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "type": "string", "minLength": 1 },
        "idempotent": { "type": "boolean" },
        "timeout": { "type": "string" },
        "input": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "output": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "urls": { "type": "array", "items": { "$ref": "#/$defs/name" } },
            "secrets": { "type": "array", "items": { "$ref": "#/$defs/name" } }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "enum": ["text", "integer", "decimal", "boolean", "date", "date-time"] },
        "required": { "type": "boolean" }
      }
    }
  }
}
