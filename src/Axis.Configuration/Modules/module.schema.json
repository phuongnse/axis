{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "label"],
  "properties": {
    "kind": { "const": "module" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "label": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/roleSlot" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "roleSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 60 },
        "label": {
          "type": "object",
          "additionalProperties": false,
          "required": ["textKey"],
          "properties": {
            "textKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
