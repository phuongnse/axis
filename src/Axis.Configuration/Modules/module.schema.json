{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "label"],
  "properties": {
    "kind": { "const": "module" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "label": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/roleSlot" }
    },
    "connectors": {
      "type": "array",
      "items": { "$ref": "#/$defs/connectorSlot" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "roleSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 60 },
        "label": {
          "type": "object",
          "additionalProperties": false,
          "required": ["textKey"],
          "properties": {
            "textKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "connectorName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "connectorType": {
      "enum": ["text", "integer", "decimal", "boolean", "date", "date-time"]
    },
    "connectorField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/connectorName" },
        "type": { "$ref": "#/$defs/connectorType" },
        "required": { "type": "boolean" }
      }
    },
    "slotOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/connectorName" },
        "input": { "type": "array", "items": { "$ref": "#/$defs/connectorField" } },
        "output": { "type": "array", "items": { "$ref": "#/$defs/connectorField" } }
      }
    },
    "connectorSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "operations"],
      "properties": {
        "name": { "$ref": "#/$defs/connectorName" },
        "label": {
          "type": "object",
          "additionalProperties": false,
          "required": ["textKey"],
          "properties": {
            "textKey": { "type": "string", "minLength": 1 }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slotOperation" }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
