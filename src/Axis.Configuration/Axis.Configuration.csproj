<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- Keeps EF Core at the Design package's version for every project that references this one. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axis.Expressions\Axis.Expressions.csproj" />
    <ProjectReference Include="..\Axis.Extensions\Axis.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Axis.Configuration.Tests" />
    <InternalsVisibleTo Include="Axis.Scenarios" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schemas\*.schema.json" LogicalName="Axis.Configuration.Schemas.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Packages\axis-package.schema.json" LogicalName="Axis.Configuration.Packages.axis-package.schema.json" />
    <EmbeddedResource Include="Modules\module.schema.json" LogicalName="Axis.Configuration.Modules.module.schema.json" />
  </ItemGroup>

</Project>
