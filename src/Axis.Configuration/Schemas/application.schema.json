{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "application" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "label": { "$ref": "#/$defs/textReference" },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "textReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textKey"],
      "properties": {
        "textKey": { "type": "string", "minLength": 1 }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
