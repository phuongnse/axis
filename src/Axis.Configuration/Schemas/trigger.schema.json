{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis trigger",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "type", "process"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "trigger" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "type": { "enum": ["event", "dataChange", "schedule"] },
    "event": { "$ref": "#/$defs/qualifiedName" },
    "entity": { "$ref": "#/$defs/name" },
    "on": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["create", "update"] }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "when": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["async", "sync"] },
    "schedule": { "type": "string", "minLength": 1 },
    "timeZone": { "type": "string", "minLength": 1 },
    "dataSource": { "$ref": "#/$defs/name" },
    "parameters": { "type": "object", "propertyNames": { "$ref": "#/$defs/name" } },
    "process": { "$ref": "#/$defs/name" }
  },
  "allOf": [
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "event" } } },
      "then": {
        "required": ["event"],
        "properties": { "entity": false, "on": false, "fields": false, "schedule": false, "timeZone": false, "dataSource": false, "parameters": false }
      }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "dataChange" } } },
      "then": {
        "required": ["entity", "on"],
        "properties": { "event": false, "mode": false, "schedule": false, "timeZone": false, "dataSource": false, "parameters": false }
      }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "schedule" } } },
      "then": {
        "required": ["schedule", "timeZone", "dataSource"],
        "properties": { "event": false, "entity": false, "on": false, "fields": false, "when": false, "mode": false }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "qualifiedName": {
      "type": "string",
      "pattern": "^([A-Za-z][A-Za-z0-9]*|[a-z][a-z0-9-]*/[A-Za-z][A-Za-z0-9]*)$",
      "maxLength": 121
    }
  }
}
