{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis trigger",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "type", "event", "process"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "trigger" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "type": { "const": "event" },
    "event": { "$ref": "#/$defs/name" },
    "when": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["async", "sync"] },
    "process": { "$ref": "#/$defs/name" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    }
  }
}
