{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis role",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "label"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "role" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "label": { "$ref": "#/$defs/textReference" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 60
    },
    "textReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textKey"],
      "properties": {
        "textKey": { "type": "string", "minLength": 1, "x-axis-reference": "text" }
      }
    }
  }
}
