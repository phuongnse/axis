{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "users", "steps"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "scenario" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "now": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "users": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/roleName", "x-axis-reference": "role" }
      }
    },
    "stubs": {
      "type": "array",
      "items": { "$ref": "#/$defs/stub" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "qualifiedName": {
      "type": "string",
      "pattern": "^([A-Za-z][A-Za-z0-9]*|[a-z][a-z0-9-]*/[A-Za-z][A-Za-z0-9]*)$"
    },
    "roleName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 60
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "stub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "operation"],
          "properties": {
            "name": { "$ref": "#/$defs/name", "x-axis-reference": "connector" },
            "operation": { "$ref": "#/$defs/name", "x-axis-reference": { "part": "operation", "of": "1/name" } }
          }
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/[A-Za-z][A-Za-z0-9]*$"
        },
        "output": { "type": "object" },
        "outcome": { "const": "failed" }
      },
      "allOf": [
        { "oneOf": [{ "required": ["connector"] }, { "required": ["operation"] }] },
        { "oneOf": [{ "required": ["output"] }, { "required": ["outcome"] }] }
      ]
    },
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "$ref": "#/$defs/reference" },
        "role": { "$ref": "#/$defs/roleName", "x-axis-reference": "role" }
      },
      "oneOf": [{ "required": ["user"] }, { "required": ["role"] }]
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "$ref": "#/$defs/reference" },
        "role": { "$ref": "#/$defs/roleName", "x-axis-reference": "role" },
        "email": { "type": "string", "minLength": 1 }
      },
      "oneOf": [{ "required": ["user"] }, { "required": ["role"] }, { "required": ["email"] }]
    },
    "expect": {
      "oneOf": [
        { "enum": ["denied", "notFound", "conflict"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["invalid"],
          "properties": { "invalid": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "createRecord",
            "updateRecord",
            "deleteRecord",
            "startProcess",
            "completeTask",
            "expectRecord",
            "expectInstance",
            "expectTask",
            "expectNotification",
            "advanceTime"
          ]
        },
        "entity": { "$ref": "#/$defs/qualifiedName", "x-axis-reference": "entity" },
        "record": { "$ref": "#/$defs/reference" },
        "save": { "$ref": "#/$defs/reference" },
        "as": { "$ref": "#/$defs/reference" },
        "process": { "$ref": "#/$defs/qualifiedName", "x-axis-reference": "process" },
        "step": { "$ref": "#/$defs/name", "x-axis-reference": { "part": "step", "of": "1/process" } },
        "outcome": { "$ref": "#/$defs/name", "x-axis-reference": { "part": "outcome", "of": "1/step" } },
        "state": { "enum": ["running", "waiting", "completed", "failed", "open"] },
        "assignee": { "$ref": "#/$defs/assignee" },
        "recipient": { "$ref": "#/$defs/recipient" },
        "channel": { "enum": ["inApp", "email"] },
        "values": { "type": "object" },
        "expect": { "$ref": "#/$defs/expect" },
        "by": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "advanceTime" } } },
          "then": {
            "required": ["by"],
            "properties": {
              "entity": false,
              "record": false,
              "save": false,
              "as": false,
              "process": false,
              "step": false,
              "outcome": false,
              "state": false,
              "assignee": false,
              "recipient": false,
              "channel": false,
              "values": false,
              "expect": false
            }
          },
          "else": { "properties": { "by": false } }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "not": { "const": "expectNotification" } } } },
          "then": { "properties": { "recipient": false, "channel": false } }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "createRecord" } } },
          "then": {
            "required": ["entity", "values", "as"],
            "properties": { "record": false, "process": false, "step": false, "outcome": false, "state": false, "assignee": false },
            "not": { "required": ["save", "expect"] }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "updateRecord" } } },
          "then": {
            "required": ["record", "values", "as"],
            "properties": { "entity": false, "save": false, "process": false, "step": false, "outcome": false, "state": false, "assignee": false }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "deleteRecord" } } },
          "then": {
            "required": ["record", "as"],
            "properties": { "entity": false, "save": false, "values": false, "process": false, "step": false, "outcome": false, "state": false, "assignee": false }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "startProcess" } } },
          "then": {
            "required": ["process", "record", "as"],
            "properties": { "entity": false, "save": false, "values": false, "step": false, "outcome": false, "state": false, "assignee": false }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "completeTask" } } },
          "then": {
            "required": ["record", "step", "outcome", "as"],
            "properties": { "entity": false, "save": false, "process": false, "state": false, "assignee": false }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "expectRecord" } } },
          "then": {
            "required": ["record", "values"],
            "properties": {
              "entity": false,
              "save": false,
              "as": false,
              "process": false,
              "step": false,
              "outcome": false,
              "state": false,
              "assignee": false,
              "expect": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "expectInstance" } } },
          "then": {
            "required": ["process", "record", "state"],
            "properties": {
              "entity": false,
              "save": false,
              "values": false,
              "as": false,
              "outcome": false,
              "assignee": false,
              "expect": false,
              "state": { "enum": ["running", "waiting", "completed", "failed"] }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "expectTask" } } },
          "then": {
            "required": ["record", "step"],
            "properties": {
              "entity": false,
              "save": false,
              "values": false,
              "as": false,
              "process": false,
              "outcome": false,
              "expect": false,
              "state": { "enum": ["open", "completed"] }
            },
            "oneOf": [{ "required": ["assignee"] }, { "required": ["state"] }]
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "expectNotification" } } },
          "then": {
            "required": ["recipient"],
            "properties": {
              "entity": false,
              "record": false,
              "save": false,
              "as": false,
              "process": false,
              "step": false,
              "outcome": false,
              "state": false,
              "assignee": false,
              "expect": false
            }
          }
        }
      ]
    }
  }
}
