{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis named rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "parameters", "resultType", "expression"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "rule" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "resultType": { "$ref": "#/$defs/type" },
    "expression": { "type": "string" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "type": {
      "enum": ["text", "integer", "decimal", "boolean", "date", "date-time"]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/type" }
      }
    }
  }
}
