{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "roles", "grants"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "policy" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "x-axis-reference": "role" }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/grant" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "entityAction": { "enum": ["read", "create", "update", "delete", "export", "import"] },
    "dataSourceAction": { "enum": ["read", "export"] },
    "processAction": { "enum": ["start", "inspect", "cancel", "retry", "resolve", "reassign"] },
    "endpointAction": { "enum": ["invoke"] },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "entity": { "type": "string", "minLength": 1, "x-axis-reference": "entity" },
        "dataSource": { "type": "string", "minLength": 1, "x-axis-reference": "dataSource" },
        "process": { "type": "string", "minLength": 1, "x-axis-reference": "process" },
        "endpoint": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["read", "create", "update", "delete", "export", "import", "start", "invoke", "inspect", "cancel", "retry", "resolve", "reassign"] }
        },
        "filter": { "type": "string", "minLength": 1, "x-axis-expression": true },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "x-axis-reference": { "part": "field", "of": "2/entity" } }
        }
      }
    }
  }
}
