{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis endpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "entity", "process", "input", "values"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "endpoint" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "entity": { "$ref": "#/$defs/qualifiedName", "x-axis-reference": "entity" },
    "process": { "$ref": "#/$defs/qualifiedName", "x-axis-reference": "process" },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields"],
      "properties": {
        "name": { "$ref": "#/$defs/qualifiedName", "x-axis-reference": "event" },
        "fields": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1, "x-axis-expression": true }
        }
      }
    },
    "input": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "values": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "type": "string", "minLength": 1, "x-axis-expression": true }
    },
    "output": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "wait": { "type": "string" }
  },
  "dependentRequired": {
    "output": ["wait"],
    "wait": ["output"]
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "qualifiedName": {
      "type": "string",
      "pattern": "^([A-Za-z][A-Za-z0-9]*|[a-z][a-z0-9-]*/[A-Za-z][A-Za-z0-9]*)$",
      "maxLength": 121
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": {
          "enum": ["text", "integer", "decimal", "boolean", "date", "date-time", "enum", "reference", "child-collection"]
        },
        "required": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "scale": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "target": { "type": "string", "x-axis-reference": "entity" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
