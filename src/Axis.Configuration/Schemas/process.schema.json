{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis process",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "entity", "start", "steps"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "process" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "entity": { "$ref": "#/$defs/name" },
    "startCondition": { "$ref": "#/$defs/startCondition" },
    "start": { "$ref": "#/$defs/name" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "textReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textKey"],
      "properties": {
        "textKey": { "type": "string", "minLength": 1 }
      }
    },
    "startCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "message"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "message": { "$ref": "#/$defs/textReference" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "enum": ["decision", "task", "operation", "end"] },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/branch" }
        },
        "otherwise": { "$ref": "#/$defs/name" },
        "operation": { "$ref": "#/$defs/name" },
        "set": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "next": { "$ref": "#/$defs/name" },
        "label": { "$ref": "#/$defs/textReference" },
        "assignee": { "$ref": "#/$defs/assignee" },
        "form": { "$ref": "#/$defs/name" },
        "dueIn": { "type": "string", "minLength": 1 },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outcome" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "decision" } } },
          "then": {
            "required": ["branches", "otherwise"],
            "properties": {
              "operation": false,
              "set": false,
              "next": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "task" } } },
          "then": {
            "required": ["label", "assignee", "form", "outcomes"],
            "properties": { "branches": false, "otherwise": false, "operation": false, "set": false, "next": false }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "operation" } } },
          "then": {
            "required": ["operation", "set", "next"],
            "properties": {
              "branches": false,
              "otherwise": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "end" } } },
          "then": {
            "properties": {
              "branches": false,
              "otherwise": false,
              "operation": false,
              "set": false,
              "next": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false
            }
          }
        }
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "next"],
      "properties": {
        "when": { "type": "string", "minLength": 1 },
        "next": { "$ref": "#/$defs/name" }
      }
    },
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "next"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "label": { "$ref": "#/$defs/textReference" },
        "next": { "$ref": "#/$defs/name" }
      }
    }
  }
}
