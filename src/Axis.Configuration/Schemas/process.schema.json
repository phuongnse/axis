{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis process",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "entity", "start", "steps"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "process" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "entity": { "$ref": "#/$defs/qualifiedName" },
    "startCondition": { "$ref": "#/$defs/startCondition" },
    "start": { "$ref": "#/$defs/name" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "qualifiedName": {
      "type": "string",
      "pattern": "^([A-Za-z][A-Za-z0-9]*|[a-z][a-z0-9-]*/[A-Za-z][A-Za-z0-9]*)$",
      "maxLength": 121
    },
    "stepOperation": {
      "type": "string",
      "pattern": "^([A-Za-z][A-Za-z0-9]*|[a-z][a-z0-9-]*/[A-Za-z][A-Za-z0-9]*)$"
    },
    "textReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textKey"],
      "properties": {
        "textKey": { "type": "string", "minLength": 1 }
      }
    },
    "startCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "message"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "message": { "$ref": "#/$defs/textReference" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "enum": ["decision", "task", "operation", "end"] },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/branch" }
        },
        "otherwise": { "$ref": "#/$defs/name" },
        "operation": { "$ref": "#/$defs/stepOperation" },
        "set": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "connector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "operation"],
          "properties": {
            "name": { "$ref": "#/$defs/name" },
            "operation": { "$ref": "#/$defs/name" }
          }
        },
        "input": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "output": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/name" }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "backoff": { "type": "string", "minLength": 1 }
          }
        },
        "event": { "$ref": "#/$defs/qualifiedName" },
        "fields": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "next": { "$ref": "#/$defs/name" },
        "label": { "$ref": "#/$defs/textReference" },
        "assignee": { "$ref": "#/$defs/assignee" },
        "form": { "$ref": "#/$defs/name" },
        "dueIn": { "type": "string", "minLength": 1 },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outcome" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "decision" } } },
          "then": {
            "required": ["branches", "otherwise"],
            "properties": {
              "operation": false,
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "fields": false,
              "next": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "task" } } },
          "then": {
            "required": ["label", "assignee", "form", "outcomes"],
            "properties": {
              "branches": false,
              "otherwise": false,
              "operation": false,
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "fields": false,
              "next": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "operation" } } },
          "then": {
            "required": ["operation", "next"],
            "properties": {
              "branches": false,
              "otherwise": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "end" } } },
          "then": {
            "properties": {
              "branches": false,
              "otherwise": false,
              "operation": false,
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "fields": false,
              "next": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false
            }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "const": "updateRecord" } }
          },
          "then": {
            "required": ["set"],
            "properties": { "connector": false, "input": false, "output": false, "retry": false, "event": false, "fields": false }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "const": "callConnector" } }
          },
          "then": {
            "required": ["connector", "input"],
            "properties": { "set": false, "event": false, "fields": false }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "const": "raiseEvent" } }
          },
          "then": {
            "required": ["event", "fields"],
            "properties": { "set": false, "connector": false, "input": false, "output": false, "retry": false }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "type": "string", "pattern": "/" } }
          },
          "then": {
            "required": ["input"],
            "properties": { "set": false, "connector": false, "event": false, "fields": false }
          }
        }
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "next"],
      "properties": {
        "when": { "type": "string", "minLength": 1 },
        "next": { "$ref": "#/$defs/name" }
      }
    },
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "next"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "label": { "$ref": "#/$defs/textReference" },
        "next": { "$ref": "#/$defs/name" }
      }
    }
  }
}
