{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis process",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "start", "steps"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "process" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "entity": { "$ref": "#/$defs/qualifiedName", "x-axis-reference": "entity" },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "startCondition": { "$ref": "#/$defs/startCondition" },
    "start": { "$ref": "#/$defs/name" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "qualifiedName": {
      "type": "string",
      "pattern": "^([A-Za-z][A-Za-z0-9]*|[a-z][a-z0-9-]*/[A-Za-z][A-Za-z0-9]*)$",
      "maxLength": 121
    },
    "type": {
      "enum": ["text", "integer", "decimal", "boolean", "date", "date-time"]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/type" }
      }
    },
    "stepOperation": {
      "type": "string",
      "pattern": "^([A-Za-z][A-Za-z0-9]*|[a-z][a-z0-9-]*/[A-Za-z][A-Za-z0-9]*)$"
    },
    "textReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textKey"],
      "properties": {
        "textKey": { "type": "string", "minLength": 1, "x-axis-reference": "text" }
      }
    },
    "startCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "message"],
      "properties": {
        "expression": { "type": "string", "minLength": 1, "x-axis-expression": true },
        "message": { "$ref": "#/$defs/textReference" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "enum": ["decision", "task", "operation", "subProcess", "end", "timer"] },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/branch" }
        },
        "otherwise": { "$ref": "#/$defs/name" },
        "operation": { "$ref": "#/$defs/stepOperation" },
        "set": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1, "x-axis-expression": true }
        },
        "connector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "operation"],
          "properties": {
            "name": { "$ref": "#/$defs/name", "x-axis-reference": "connector" },
            "operation": { "$ref": "#/$defs/name", "x-axis-reference": { "part": "operation", "of": "1/name" } }
          }
        },
        "input": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1, "x-axis-expression": true }
        },
        "output": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/name" }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "backoff": { "type": "string", "minLength": 1 }
          }
        },
        "event": { "$ref": "#/$defs/qualifiedName", "x-axis-reference": "event" },
        "entity": { "$ref": "#/$defs/qualifiedName", "x-axis-reference": "entity" },
        "fields": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1, "x-axis-expression": true }
        },
        "to": {
          "type": "array",
          "items": { "$ref": "#/$defs/recipient" }
        },
        "channels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["inApp", "email"] }
        },
        "message": { "$ref": "#/$defs/notifyMessage" },
        "open": { "$ref": "#/$defs/notifyOpen" },
        "process": { "$ref": "#/$defs/name" },
        "subject": { "type": "string", "minLength": 1, "x-axis-expression": true },
        "parameters": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1, "x-axis-expression": true }
        },
        "next": { "$ref": "#/$defs/name", "x-axis-reference": { "part": "step", "of": "/name" } },
        "label": { "$ref": "#/$defs/textReference" },
        "assignee": { "$ref": "#/$defs/assignee" },
        "form": { "$ref": "#/$defs/name", "x-axis-reference": "form" },
        "dueIn": { "type": "string", "minLength": 1 },
        "wait": { "type": "string", "minLength": 1 },
        "until": { "type": "string", "minLength": 1, "x-axis-expression": true },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outcome" }
        },
        "deadline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["after", "next"],
          "properties": {
            "after": { "type": "string", "minLength": 1 },
            "next": { "$ref": "#/$defs/name", "x-axis-reference": { "part": "step", "of": "/name" } }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "decision" } } },
          "then": {
            "required": ["branches", "otherwise"],
            "properties": {
              "process": false,
              "subject": false,
              "parameters": false,
              "operation": false,
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "entity": false,
              "fields": false,
              "to": false,
              "channels": false,
              "message": false,
              "open": false,
              "next": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false,
              "deadline": false,
              "wait": false,
              "until": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "task" } } },
          "then": {
            "required": ["label", "assignee", "form", "outcomes"],
            "properties": {
              "process": false,
              "subject": false,
              "parameters": false,
              "branches": false,
              "otherwise": false,
              "operation": false,
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "entity": false,
              "fields": false,
              "to": false,
              "channels": false,
              "message": false,
              "open": false,
              "next": false,
              "wait": false,
              "until": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "operation" } } },
          "then": {
            "required": ["operation", "next"],
            "properties": {
              "process": false,
              "subject": false,
              "parameters": false,
              "branches": false,
              "otherwise": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false,
              "deadline": false,
              "wait": false,
              "until": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "subProcess" } } },
          "then": {
            "required": ["process", "next"],
            "properties": {
              "branches": false,
              "otherwise": false,
              "operation": false,
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "entity": false,
              "fields": false,
              "to": false,
              "channels": false,
              "message": false,
              "open": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false,
              "deadline": false,
              "wait": false,
              "until": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "end" } } },
          "then": {
            "properties": {
              "process": false,
              "subject": false,
              "parameters": false,
              "branches": false,
              "otherwise": false,
              "operation": false,
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "entity": false,
              "fields": false,
              "to": false,
              "channels": false,
              "message": false,
              "open": false,
              "next": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false,
              "deadline": false,
              "wait": false,
              "until": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "timer" } } },
          "then": {
            "required": ["next"],
            "properties": {
              "process": false,
              "subject": false,
              "parameters": false,
              "branches": false,
              "otherwise": false,
              "operation": false,
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "fields": false,
              "to": false,
              "channels": false,
              "message": false,
              "open": false,
              "label": false,
              "assignee": false,
              "form": false,
              "dueIn": false,
              "outcomes": false,
              "deadline": false
            }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "const": "updateRecord" } }
          },
          "then": {
            "required": ["set"],
            "properties": {
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "entity": false,
              "fields": false,
              "to": false,
              "channels": false,
              "message": false,
              "open": false
            }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "const": "createRecord" } }
          },
          "then": {
            "required": ["entity", "set"],
            "properties": {
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "fields": false,
              "to": false,
              "channels": false,
              "message": false,
              "open": false
            }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "const": "callConnector" } }
          },
          "then": {
            "required": ["connector", "input"],
            "properties": { "set": false, "event": false, "entity": false, "fields": false, "to": false, "channels": false, "message": false, "open": false }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "const": "raiseEvent" } }
          },
          "then": {
            "required": ["event", "fields"],
            "properties": {
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "entity": false,
              "to": false,
              "channels": false,
              "message": false,
              "open": false
            }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "type": "string", "pattern": "/" } }
          },
          "then": {
            "required": ["input"],
            "properties": { "set": false, "connector": false, "event": false, "entity": false, "fields": false, "to": false, "channels": false, "message": false, "open": false }
          }
        },
        {
          "if": {
            "required": ["type", "operation"],
            "properties": { "type": { "const": "operation" }, "operation": { "const": "notify" } }
          },
          "then": {
            "required": ["to", "channels", "message"],
            "properties": {
              "set": false,
              "connector": false,
              "input": false,
              "output": false,
              "retry": false,
              "event": false,
              "entity": false,
              "fields": false
            }
          }
        }
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "next"],
      "properties": {
        "when": { "type": "string", "minLength": 1, "x-axis-expression": true },
        "next": { "$ref": "#/$defs/name", "x-axis-reference": { "part": "step", "of": "/name" } }
      }
    },
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "type": "string", "minLength": 1, "x-axis-expression": true },
        "role": { "type": "string", "minLength": 1, "x-axis-reference": "role" }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "type": "string", "minLength": 1, "x-axis-expression": true },
        "role": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1, "x-axis-expression": true }
      }
    },
    "notifyMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "body"],
      "properties": {
        "subject": { "$ref": "#/$defs/textReference" },
        "body": { "$ref": "#/$defs/textReference" },
        "values": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9]+$" },
          "additionalProperties": { "type": "string", "minLength": 1, "x-axis-expression": true }
        }
      }
    },
    "notifyOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page"],
      "properties": {
        "page": { "$ref": "#/$defs/name", "x-axis-reference": "page" },
        "parameters": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "minLength": 1, "x-axis-expression": true }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "next"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "label": { "$ref": "#/$defs/textReference" },
        "next": { "$ref": "#/$defs/name", "x-axis-reference": { "part": "step", "of": "/name" } }
      }
    }
  }
}
