{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis site",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "path", "title", "locales", "navigation"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "site" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "path": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 60
    },
    "title": { "$ref": "#/$defs/textReference" },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "fallback", "available"],
      "properties": {
        "default": { "$ref": "#/$defs/locale" },
        "fallback": { "$ref": "#/$defs/locale" },
        "available": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/locale" }
        }
      }
    },
    "navigation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "label"],
        "properties": {
          "page": { "$ref": "#/$defs/name" },
          "label": { "$ref": "#/$defs/textReference" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "textReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textKey"],
      "properties": {
        "textKey": { "type": "string", "minLength": 1 }
      }
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    }
  }
}
