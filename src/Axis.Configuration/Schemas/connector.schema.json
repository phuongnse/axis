{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis connector",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "baseUrl", "operations"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "connector" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "baseUrl": { "$ref": "#/$defs/binding" },
    "auth": { "$ref": "#/$defs/auth" },
    "timeout": { "type": "string" },
    "idempotency": { "$ref": "#/$defs/header" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "type": {
      "enum": ["text", "integer", "decimal", "boolean", "date", "date-time"]
    },
    "header": {
      "type": "string",
      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
      "maxLength": 100
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding"],
      "properties": {
        "binding": { "$ref": "#/$defs/name" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["none", "bearer", "header", "oauth2"] },
        "token": { "$ref": "#/$defs/binding" },
        "name": { "$ref": "#/$defs/header" },
        "value": { "$ref": "#/$defs/binding" },
        "tokenUrl": { "$ref": "#/$defs/binding" },
        "clientId": { "$ref": "#/$defs/binding" },
        "clientSecret": { "$ref": "#/$defs/binding" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "none" } } },
          "then": {
            "properties": {
              "token": false,
              "name": false,
              "value": false,
              "tokenUrl": false,
              "clientId": false,
              "clientSecret": false,
              "scope": false,
              "audience": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "bearer" } } },
          "then": {
            "required": ["token"],
            "properties": {
              "name": false,
              "value": false,
              "tokenUrl": false,
              "clientId": false,
              "clientSecret": false,
              "scope": false,
              "audience": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "header" } } },
          "then": {
            "required": ["name", "value"],
            "properties": {
              "token": false,
              "tokenUrl": false,
              "clientId": false,
              "clientSecret": false,
              "scope": false,
              "audience": false
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "oauth2" } } },
          "then": {
            "required": ["tokenUrl", "clientId", "clientSecret"],
            "properties": { "token": false, "name": false, "value": false }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/type" },
        "required": { "type": "boolean" }
      }
    },
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/type" },
        "required": { "type": "boolean" },
        "in": { "enum": ["body", "path", "query", "header"] }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "method", "path"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/", "maxLength": 2000 },
        "input": { "type": "array", "items": { "$ref": "#/$defs/inputField" } },
        "output": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "lookup": { "$ref": "#/$defs/name", "x-axis-reference": { "part": "operation", "of": "/name" } }
      }
    }
  }
}
