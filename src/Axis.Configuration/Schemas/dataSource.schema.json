{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis data source over one root entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "formatVersion", "entity", "fields"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "kind": { "const": "dataSource" },
    "name": { "$ref": "#/$defs/name" },
    "formatVersion": { "const": 1 },
    "entity": { "$ref": "#/$defs/name" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "filter": { "type": "string" },
    "aggregate": { "$ref": "#/$defs/aggregate" },
    "sort": {
      "type": "string",
      "pattern": "^-?[A-Za-z][A-Za-z0-9]*$"
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "textReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textKey"],
      "properties": {
        "textKey": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupBy", "measures"],
      "properties": {
        "groupBy": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "measures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/measure" }
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "function"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "function": { "enum": ["count", "sum", "min", "max"] },
        "field": { "$ref": "#/$defs/name" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": {
          "enum": ["text", "integer", "decimal", "boolean", "date", "date-time", "enum", "reference"]
        },
        "required": { "type": "boolean" },
        "label": { "$ref": "#/$defs/textReference" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "target": { "type": "string" }
      }
    }
  }
}
