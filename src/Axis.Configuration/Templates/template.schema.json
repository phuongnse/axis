{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axis application template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "title", "description"],
  "properties": {
    "kind": { "const": "applicationTemplate" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "builtIn": { "type": "boolean" }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "vi"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "vi": { "type": "string", "minLength": 1 }
      }
    }
  }
}
