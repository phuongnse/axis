<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scripts run host mode from the build output, and the Node.js runner sits beside the dll. The published output leaves it out, see docs/reference/extension-packages.md#the-runner-protocol. -->
    <None Include="..\..\sdk\node\**\*" LinkBase="sdk/node" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Axis.PackageHost.Tests" />
    <InternalsVisibleTo Include="Axis.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axis.Configuration\Axis.Configuration.csproj" />
    <ProjectReference Include="..\Axis.Extensions\Axis.Extensions.csproj" />
  </ItemGroup>

</Project>
