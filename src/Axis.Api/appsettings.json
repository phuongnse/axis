{
  "OpenTelemetry": {
    "Enabled": true,
    "DisableInTesting": true,
    "ServiceName": "axis-api",
    "ExportLogs": true,
    "Otlp": {
      "Endpoint": "http://localhost:4318"
    },
    "Prometheus": {
      "Enabled": true,
      "ScrapeEndpointPath": "/metrics"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Identity": "Host=localhost;Port=5432;Database=axis_identity;Username=axis;Password=axis_dev_pass",
    "Authorization": "Host=localhost;Port=5432;Database=axis_authorization;Username=axis;Password=axis_dev_pass",
    "BusinessObjects": "Host=localhost;Port=5432;Database=axis_business_objects;Username=axis;Password=axis_dev_pass",
    "Rules": "Host=localhost;Port=5432;Database=axis_rules;Username=axis;Password=axis_dev_pass",
    "Solutions": "Host=localhost;Port=5432;Database=axis_solutions;Username=axis;Password=axis_dev_pass",
    "Audit": "Host=localhost;Port=5432;Database=axis_audit;Username=axis;Password=axis_dev_pass"
  },
  "Audit": {
    "MaxPendingAgeSeconds": 300
  },
  "AuthorizationAudit": {
    "OverdueMinutes": 5
  },
  "SolutionsAudit": {
    "OverdueMinutes": 5
  },
  "Solutions": {
    "AxisOpenApiSha256": "5ca3b6e62c1950ed3a1524f04f4e38226a187f7e0119ec9d5ac9a101b7135548"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "App": {
    "BaseUrl": "https://localhost:3000"
  },
  "OpenIddict": {
    "Issuer": "https://localhost:5281",
    "ClientCatalog": {
      "SchemaVersion": 1,
      "Clients": [
        {
          "ClientId": "axis_mcp",
          "DisplayName": "Axis MCP local client",
          "Profile": "NativePublic",
          "RedirectUris": ["http://127.0.0.1:48123/callback"],
          "PostLogoutRedirectUris": []
        }
      ]
    }
  },
  "Jwt": {
    "SecretKey": "change-me-in-production-must-be-at-least-32-chars!!",
    "Issuer": "axis",
    "Audience": "axis",
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlHours": 8
  },
  "BrowserSession": {
    "IdleMinutes": 30,
    "AbsoluteHours": 8
  },
  "IdentityAudit": {
    "OverdueMinutes": 5
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@axis.localhost",
    "FromName": "Axis Platform"
  },
  "AllowedHosts": "*"
}
